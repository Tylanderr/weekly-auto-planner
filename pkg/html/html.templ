package html

import (
	"strconv"
	"sort"
)

type Meal struct {
	Id          int          `json:"id"`
	Name        string       `json:"name"`
	Description string       `json:"description"`
	Ingredients []Ingredient `json:"ingredients"`
}

type Ingredient struct {
	Id                  int     `json:"id"`
	Name                string  `json:"name"`
	Quantity            float64 `json:"quantity"`
	Unit                string  `json:"unit"`
	GroceryCategoryId   int     `json:"grocery_category_id"`
	GroceryCategoryName string  `json:"grocery_category_name"`
}

type CategoryGroup struct {
	CategoryName string
	Ingredients  []Ingredient
}

func groupIngredientsByCategory(meals []Meal) []CategoryGroup {
	categoryMap := make(map[string][]Ingredient)
	
	for _, meal := range meals {
		for _, ingredient := range meal.Ingredients {
			if ingredient.GroceryCategoryName == "" {
				continue
			}
			categoryMap[ingredient.GroceryCategoryName] = append(categoryMap[ingredient.GroceryCategoryName], ingredient)
		}
	}
	
	var groups []CategoryGroup
	for categoryName, ingredients := range categoryMap {
		groups = append(groups, CategoryGroup{
			CategoryName: categoryName,
			Ingredients:  ingredients,
		})
	}
	
	sort.Slice(groups, func(i, j int) bool {
		return groups[i].CategoryName < groups[j].CategoryName
	})
	
	return groups
}

templ categoryRow(group CategoryGroup) {
	<tr>
		<td>{ group.CategoryName }</td>
		<td>
			for _, ingredient := range group.Ingredients {
				<div>{ ingredient.Name } - { strconv.FormatFloat(ingredient.Quantity, 'f', -1, 64) } { ingredient.Unit }</div>
			}
		</td>
	</tr>
}

templ Email(meals []Meal) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>Weekly Meals</title>
			<style>
				table {
					border-collapse: collapse;
					width: 100%;
					font-family: Arial, sans-serif;
				}

				table-small {
					border-collapse: collapse;
					width: 100%;
					font-family: Arial, sans-serif;
				}

				table th,
				table td {
					border: 1px solid #ccc;
					padding: 8px 12px;
					text-align: left;
				}

				table th {
					background-color: #f4f4f4;
					font-weight: bold;
				}
			</style>
		</head>
		<body>
			<h1>Meals for this week:</h1>
			<table>
				<tr>
					<th>Grocery Type</th>
					<th>Ingredients</th>
				</tr>
				for _, group := range groupIngredientsByCategory(meals) {
					@categoryRow(group)
				}
			</table>
		</body>
	</html>
}
